// A conversion projects a channel by default. It does not take ownership of
// the source channel. Each projection awaits its own finite boundary.

const bytes = @types.bytes(channel)
const text = @types.string(channel)
const hash = @crypto.sha256(channel)

// Infinite channels require an explicit finite projection before they can be
// materialized as a basic value.

const head = @types.bytes(channel.take(1024))
const line = @types.string(channel.until("\n"))
const recent = @types.bytes(channel.window(@time.seconds(1)))

// Consumption is explicit. It transfers ownership of the channel and permits
// destructive reads, buffer reuse, and zero-copy materialization.

const owned = @types.bytes(channel.consume())

// History is never retained implicitly. A dynamic projection starts at the
// current frontier unless replay or a bounded window was requested explicitly.

const replayable = channel.replay(1024)
const replayed = @types.bytes(replayable)

