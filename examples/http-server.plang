// `listen` produces an infinite stream of requests.
// `concurrent` is a metaprogrammed shape: it expands the handler into the
// stream graph instead of turning the request stream into a collection.

func main() {
    const requests = @http.listen("0.0.0.0:8080")

    // Consumption awaits by default. Because `requests` never ends, this call
    // keeps accepting and dispatching requests for the lifetime of the server.
    @stream.concurrent(requests, handle)
}

func handle(request) {
    // Each conversion explicitly observes a stream and awaits its terminator.
    // Request metadata streams are finite, so these produce scalar values.
    const method = @types.string(request.method)
    const path = @types.string(request.path)

    if method == "POST" && path == "/echo" {
        // The request body may arrive in any number of chunks. This conversion
        // waits for @channel.end and then projects one contiguous value. It
        // does not consume the source channel or invalidate other projections.
        const body = @types.bytes(request.body)

        request.response.status << @types.u16(200)
        request.response.headers << ["content-type", "application/octet-stream"]
        request.response.body << body
        request.response.body << @channel.end
        @func.exit << 0
    }

    request.response.status << @types.u16(404)
    request.response.headers << ["content-type", "text/plain; charset=utf-8"]
    request.response.body << "not found"
    request.response.body << @channel.end
    @func.exit << 0
}

// This is valid but intentionally never completes: an infinite stream cannot
// be materialized into a finite slice unless it eventually emits @channel.end.
func collect_forever() {
    const requests = @http.listen("0.0.0.0:8081")
    const all_requests = @types.slice(requests)
    @channel.out << all_requests
}
